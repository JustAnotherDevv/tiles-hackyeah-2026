# Aegis environment (CONTRACTS section 6.5). Copy to .env if you need overrides; all have defaults.
# Gateway
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8787
AEGIS_POLICY=config/policy.yaml
AEGIS_ORG_SEED=config/org.seed.yaml
AEGIS_PRICING=config/pricing.yaml
AEGIS_DATA_DIR=data
AEGIS_MODELS_DIR=models
# AEGIS_HMAC_KEY=            # unset -> generated once into data/keys/hmac.key
AEGIS_FEED_URL=http://127.0.0.1:8790   # "disabled" = seed bundle only
AEGIS_FEED_PUBKEY=config/feeds/feed_pubkey.b64
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_SEMANTIC=auto           # on | off | auto  (off = heuristic only, used by unit tests)
AEGIS_DEMO_MODE=1             # header identity + dashboard "view as" allowed
# AEGIS_DEFAULT_VIEWER=u_katarzyna
# AEGIS_ADMIN_TOKEN=          # if set, mutating /api/* also need Authorization: Bearer <token>
AEGIS_UI_DIST=web/dist
AEGIS_HOST_MAP=exfil.test=127.0.0.1:8793,paste.test=127.0.0.1:8794,pay.saas.test=127.0.0.1:8794,crm.saas.test=127.0.0.1:8794
# AEGIS_VAULT_SECRET=         # random per process when unset
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=0
AEGIS_ACCESS_LOG=0
AEGIS_TEST_MODE=0             # 1 = no watchers/pollers/background loops
# AEGIS_LIVE_URL=http://127.0.0.1:8787   # test-suite live mode

# Optional remote providers (enabled only when set)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Claude Code hook client (scripts/aegis-hook)
# AEGIS_URL=http://127.0.0.1:8787
# AEGIS_AGENT=claude-code@platform
# AEGIS_AGENT_KEY=aegis_demo_cc_platform_0000000000000001_NOT_A_SECRET
# AEGIS_HOOK_TIMEOUT=110

# Frontend (Vite)
# VITE_AEGIS_API=             # empty = same origin
# VITE_AEGIS_MOCK=0           # 1 = force mock data
