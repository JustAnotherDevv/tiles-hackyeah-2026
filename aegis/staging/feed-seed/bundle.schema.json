{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/threat-intel-bundle-v1.json",
  "title": "Aegis threat-intel bundle + latest pointer (schema_version 1)",
  "description": "Both documents carry an Ed25519 `signature` (base64) over canonical JSON of the document without the `signature` key: json.dumps(doc, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode('utf-8'). Each signature item is validated separately against schema.json.",
  "$defs": {
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feed", "schema_version", "serial", "created", "expires", "alg", "key_id", "signature_count", "signatures", "signature"],
      "properties": {
        "feed": {"const": "aegis-threat-intel"},
        "schema_version": {"const": 1},
        "serial": {"type": "integer", "minimum": 1, "description": "strictly monotonic; gateways reject serial < last accepted (anti-rollback)"},
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "after this the feed is stale: alert, keep enforcing last-known-good"},
        "min_gateway_version": {"type": "string"},
        "alg": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "first 16 hex chars of sha256(raw 32-byte public key)"},
        "signature_count": {"type": "integer", "minimum": 0},
        "signatures": {"type": "array", "maxItems": 5000, "items": {"type": "object"}},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feed", "schema_version", "serial", "created", "expires", "bundle", "sha256", "signature_count", "alg", "key_id", "signature"],
      "properties": {
        "feed": {"const": "aegis-threat-intel"},
        "schema_version": {"const": 1},
        "serial": {"type": "integer", "minimum": 1},
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "bundle": {"type": "string", "pattern": "^bundle-[0-9]{6}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the bundle file bytes as served"},
        "signature_count": {"type": "integer", "minimum": 0},
        "alg": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
