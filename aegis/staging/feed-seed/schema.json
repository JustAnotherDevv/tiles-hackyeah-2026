{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/threat-intel-signature-v1.json",
  "title": "Aegis threat-intel signature (schema_version 1)",
  "description": "One historical-attack signature. Pure data: matchers are a closed set of declarative types; feeds never carry code. Regexes are RE2 syntax.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "severity", "aliases", "references", "tags", "applies_to", "matcher", "action", "tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^AEGIS-TI-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 8, "maxLength": 140},
    "description": {"type": "string", "maxLength": 4000},
    "status": {
      "description": "experimental = evaluated + logged but never enforced (monitor); test/stable/deprecated = enforced; withdrawn = not evaluated (never delete a signature, withdraw it).",
      "enum": ["experimental", "test", "stable", "deprecated", "withdrawn"]
    },
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "aliases": {
      "description": "CVE / GHSA / vendor advisory IDs.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA(-[23456789cfghjmpqrvwx]{4}){3}|[A-Z][A-Z0-9]{1,15}-[A-Za-z0-9][A-Za-z0-9.-]*)$"}
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[^\\s]+$"}
    },
    "tags": {
      "description": "Framework mappings: OWASP LLM Top 10 2026 (LLM01:2026..LLM10:2026), OWASP Agentic ASI01..ASI10, OWASP MCP Top 10 (MCP01:2025..MCP10:2025), MITRE ATLAS (AML.T0051), CWE (CWE-502), or a lowercase free tag.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(LLM(0[1-9]|10):2026|ASI(0[1-9]|10)|MCP(0[1-9]|10):2025|AML\\.(T|CS)[0-9]{4}(\\.[0-9]{3})?|CWE-[0-9]{1,5}|[a-z][a-z0-9-]{1,31})$"}
    },
    "published": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "modified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "applies_to": {
      "description": "Interception surfaces this signature is evaluated on.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/surface"}
    },
    "matcher": {"$ref": "#/$defs/matcher"},
    "action": {"$ref": "#/$defs/action"},
    "action_overrides": {
      "description": "Per-surface action (e.g. block on tool_call, alert on output).",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/surface"},
      "additionalProperties": {"$ref": "#/$defs/action"}
    },
    "message": {"type": "string", "maxLength": 400, "description": "Shown to the agent/user when the signature fires; written so a model can read it and stop."},
    "notes": {"type": "string", "maxLength": 4000},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/example"}},
        "negative": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/example"}}
      }
    }
  },
  "$defs": {
    "surface": {"enum": ["model_call", "tool_call", "mcp", "egress", "model_download", "output"]},
    "action": {"enum": ["block", "require_approval", "quarantine", "strip_tool", "redact", "alert"]},
    "field": {
      "description": "Which view of the event a text matcher reads. all = text + url + body + filename + every JSON string (+ synthetic 'command args…' line for launch configs) + compact JSON.",
      "enum": ["all", "text", "url", "body", "filename", "bytes"]
    },
    "regex_pattern": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "RE2 syntax (no lookaround, no backreferences, repetition <= 1000)."},
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "surface"],
      "properties": {
        "name": {"type": "string", "minLength": 3, "maxLength": 160},
        "surface": {"$ref": "#/$defs/surface"},
        "note": {"type": "string"},
        "text": {"type": "string"},
        "json": {},
        "url": {"type": "string"},
        "method": {"type": "string", "pattern": "^[A-Z]{3,7}$"},
        "body": {"type": "string"},
        "filename": {"type": "string"},
        "bytes_hex": {"type": "string", "pattern": "^[0-9a-fA-F\\s]+$"},
        "bytes_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/=\\s]+$"}
      },
      "anyOf": [
        {"required": ["text"]}, {"required": ["json"]}, {"required": ["url"]},
        {"required": ["body"]}, {"required": ["bytes_hex"]}, {"required": ["bytes_b64"]}
      ],
      "x-hint": "an example needs at least one input: text, json, url, body, bytes_hex or bytes_b64"
    },
    "matcher": {
      "anyOf": [
        {"$ref": "#/$defs/any_of"}, {"$ref": "#/$defs/all_of"}, {"$ref": "#/$defs/not"},
        {"$ref": "#/$defs/regex"}, {"$ref": "#/$defs/literal"}, {"$ref": "#/$defs/url"},
        {"$ref": "#/$defs/package"}, {"$ref": "#/$defs/hash"}, {"$ref": "#/$defs/bytes"},
        {"$ref": "#/$defs/pickle_opcode"}, {"$ref": "#/$defs/jsonpath"}, {"$ref": "#/$defs/semantic_exemplar"}
      ],
      "x-hint": "a matcher is {any_of: [...]}, {all_of: [...]}, {not: {...}} or a leaf with type in regex|literal|url|package|hash|bytes|pickle_opcode|jsonpath|semantic_exemplar"
    },
    "any_of": {
      "type": "object", "additionalProperties": false, "required": ["any_of"],
      "properties": {"any_of": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/matcher"}}, "comment": {"type": "string"}}
    },
    "all_of": {
      "type": "object", "additionalProperties": false, "required": ["all_of"],
      "properties": {"all_of": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/matcher"}}, "comment": {"type": "string"}}
    },
    "not": {
      "type": "object", "additionalProperties": false, "required": ["not"],
      "properties": {"not": {"$ref": "#/$defs/matcher"}, "comment": {"type": "string"}}
    },
    "regex": {
      "type": "object", "additionalProperties": false, "required": ["type", "pattern"],
      "properties": {
        "type": {"const": "regex"},
        "pattern": {"$ref": "#/$defs/regex_pattern"},
        "field": {"$ref": "#/$defs/field"},
        "case_insensitive": {"type": "boolean"},
        "comment": {"type": "string"}
      }
    },
    "literal": {
      "type": "object", "additionalProperties": false, "required": ["type", "values"],
      "properties": {
        "type": {"const": "literal"},
        "values": {"type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 512}},
        "case_insensitive": {"type": "boolean", "description": "default true"},
        "field": {"$ref": "#/$defs/field"},
        "comment": {"type": "string"}
      }
    },
    "url": {
      "description": "Conditions are ANDed and evaluated per URL. extract=none reads the event URL (egress/model_download); markdown/text extract URLs from text first and match if ANY extracted URL satisfies all conditions.",
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"const": "url"},
        "extract": {"enum": ["none", "markdown", "text"]},
        "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["image", "link", "refdef", "html_img", "autolink", "bare"]}},
        "field": {"$ref": "#/$defs/field"},
        "scheme_in": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*$"}},
        "scheme_not_in": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*$"}},
        "host_in": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9.:\\[\\]-]+$"}},
        "host_not_in": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9.:\\[\\]-]+$"}},
        "host_regex": {"$ref": "#/$defs/regex_pattern"},
        "port_in": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
        "path_regex": {"$ref": "#/$defs/regex_pattern"},
        "query_regex": {"$ref": "#/$defs/regex_pattern"},
        "query_min_length": {"type": "integer", "minimum": 0, "maximum": 65536},
        "method_in": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]{3,7}$"}},
        "comment": {"type": "string"}
      },
      "anyOf": [
        {"required": ["scheme_in"]}, {"required": ["scheme_not_in"]}, {"required": ["host_in"]},
        {"required": ["host_not_in"]}, {"required": ["host_regex"]}, {"required": ["port_in"]},
        {"required": ["path_regex"]}, {"required": ["query_regex"]}, {"required": ["query_min_length"]},
        {"required": ["method_in"]}
      ]
    },
    "package": {
      "description": "Parses install commands (pip/uv/poetry/pdm/pipx, npm/pnpm/yarn/bun, npx/bunx/dlx, code --install-extension, MCP launch configs) and matches OSV-style entries. Empty versions = any version (e.g. hallucinated names).",
      "type": "object", "additionalProperties": false, "required": ["type", "packages"],
      "properties": {
        "type": {"const": "package"},
        "packages": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["ecosystem", "name"],
            "properties": {
              "ecosystem": {"enum": ["pypi", "npm", "vscode"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 214},
              "versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "ref": {"type": "string"}
            }
          }
        },
        "field": {"$ref": "#/$defs/field"},
        "comment": {"type": "string"}
      }
    },
    "hash": {
      "type": "object", "additionalProperties": false, "required": ["type", "sha256"],
      "properties": {
        "type": {"const": "hash"},
        "sha256": {"type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "field": {"enum": ["auto", "bytes", "text", "all", "body", "url", "filename"], "description": "auto = artifact bytes if present, else text"},
        "normalize": {"enum": ["none", "whitespace"]},
        "comment": {"type": "string"}
      }
    },
    "bytes": {
      "type": "object", "additionalProperties": false, "required": ["type", "magic_hex"],
      "properties": {
        "type": {"const": "bytes"},
        "magic_hex": {"type": "string", "pattern": "^([0-9a-f]{2}){1,64}$"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 65536},
        "comment": {"type": "string"}
      }
    },
    "pickle_opcode": {
      "description": "Streams opcodes with pickletools.genops (never unpickles), resolves GLOBAL/INST/STACK_GLOBAL (incl. memo indirection), matches any global outside allow_globals (fnmatch) or inside deny_globals. Scans every pickle-looking ZIP member regardless of extension; parse errors match when on_parse_error=match (fail closed).",
      "type": "object", "additionalProperties": false, "required": ["type", "mode", "allow_globals"],
      "properties": {
        "type": {"const": "pickle_opcode"},
        "mode": {"const": "allowlist"},
        "allow_globals": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.*]*$"}},
        "deny_globals": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.*]*$"}},
        "on_parse_error": {"enum": ["match", "ignore"]},
        "scan_zip_members": {"type": "boolean"},
        "comment": {"type": "string"}
      }
    },
    "jsonpath": {
      "description": "JSONPath-lite ($ .k .* ..k ..* [n] [*] ['a','b']). Matches when the path selects a value that equals `equals` and/or satisfies nested `match` (evaluated with the value as text/url/json). exists=false matches when nothing is selected.",
      "type": "object", "additionalProperties": false, "required": ["type", "path"],
      "properties": {
        "type": {"const": "jsonpath"},
        "path": {"type": "string", "pattern": "^\\$", "maxLength": 256},
        "exists": {"type": "boolean"},
        "equals": {"type": ["string", "number", "boolean", "null"]},
        "match": {"$ref": "#/$defs/matcher"},
        "comment": {"type": "string"}
      }
    },
    "semantic_exemplar": {
      "description": "Gateway: max cosine(embed(input), embed(exemplar)) >= threshold. Reference/offline (validate.py): char-trigram containment >= lexical_threshold.",
      "type": "object", "additionalProperties": false, "required": ["type", "exemplars", "threshold"],
      "properties": {
        "type": {"const": "semantic_exemplar"},
        "exemplars": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 1000}},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "lexical_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "embed_model": {"type": "string"},
        "field": {"$ref": "#/$defs/field"},
        "comment": {"type": "string"}
      }
    }
  }
}
