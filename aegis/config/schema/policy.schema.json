  "$id": "aegis.policy/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Control catalog, budgets, approvals and routing for the Aegis AI control layer.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionRule"
      },
      "title": "Actions",
      "type": "array"
    },
    "approvals": {
