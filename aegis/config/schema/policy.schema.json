    },
    "destinations": {
      "$ref": "#/$defs/DestinationsSection"
    },
    "feeds": {
      "$ref": "#/$defs/FeedsSection"
    },
    "mcp": {
      "$ref": "#/$defs/McpSection"
    },
    "metadata": {
      "$ref": "#/$defs/PolicyMetadata"
    },
    "models": {
      "$ref": "#/$defs/ModelsSection"
    },
    "profile": {
      "default": "balanced",
      "description": "Strictness profile (config/profiles/<name>.yaml): permissive | balanced | strict | paranoid. strict/paranoid act as a floor for pinned knobs.",
      "enum": [
        "permissive",
        "balanced",
        "strict",
        "paranoid"
      ],
      "title": "Profile",
      "type": "string"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "title": "Providers",
      "type": "object"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/PolicyTest"
      },
      "title": "Tests",
      "type": "array"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "title": "Aegis policy (config/policy.yaml)",
  "type": "object"
}
