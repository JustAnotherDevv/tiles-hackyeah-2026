            {
              "pattern": "^[A-Z0-9]+-[0-9]{2}$",
              "type": "string"
            }
          ],
          "description": "Control id from the catalog: GOV-01 Caller identity & attribution, GOV-02 Model allowlist & destination tiering, GOV-03 Tool authorization (RBAC + arg constraints), GOV-04 Human approval gate for other high-impact tools, GOV-05 Config-change governance (who may change what), GOV-06 Agent harness integrity (Claude Code), ACT-01 Spend guard (purchases, subscriptions, top-ups), ACT-02 Data access guard (tables by sensitivity & environment), ACT-03 External send guard (email, webhooks, uploads), ACT-04 Code execution & deploy guard, DLP-01 PII/PCI/Polish-ID tokenization (destination matrix), DLP-02 Secrets & credentials, DLP-03 Metadata stripping & generalization, DLP-04 Tool-arg / egress exfiltration scan, DLP-05 Output & tool-result leak detection (+ canary), DLP-06 Exfil-channel neutralization (md images/links, ANSI), DLP-07 Multilingual NER sensitive data (incl. Polish), DLP-08 Vault & controlled re-identification, INJ-01 Normalization + deterministic injection signatures, INJ-02 Semantic injection / jailbreak classifier, INJ-03 Content safety + topic adherence %, INJ-04 Hidden-context exposure (extraction + canary + overlap), INJ-05 Goal-drift / grounding check, EXE-01 Dangerous command guard, EXE-02 Filesystem & network scope (SSRF), EXE-03 Taint-flow breaker (lethal trifecta), EXE-04 Loop / rate / circuit breaker / kill switch, MCP-01 Server registry & launch check, MCP-02 Tool-definition poisoning scan, MCP-03 Tool pinning (rug pull) & shadowing, MCP-04 Token & auth hygiene, BUD-01 Token & cost budgets (remote + local, spend), BUD-02 Local compute & concurrency, SIG-01 External exploit-signature engine, SIG-02 Model-artifact gate (pickle / GGUF), SIG-03 Package-install / slopsquatting guard, CUS-01 Customer-defined rules (deal code names must not leave the firm), A2A-01 Peer identity & message integrity (reserved), A2A-02 Inter-agent smuggling guard (reserved)",
          "examples": [
            "GOV-01",
            "GOV-02",
            "GOV-03",
            "GOV-04",
            "GOV-05",
            "GOV-06",
            "ACT-01",
            "ACT-02",
            "ACT-03",
            "ACT-04",
            "DLP-01",
            "DLP-02",
            "DLP-03",
            "DLP-04",
