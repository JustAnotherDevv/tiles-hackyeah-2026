{
  "name": "gpu_480",
  "title": "$480 GPU charge via MCP is held for owner approval (ACT-01)",
  "steps": [
    {
      "event": "PreToolUse",
      "payload": {
        "session_id": "{{SESSION}}",
        "transcript_path": "{{HOME}}/.claude/projects/demo/{{SESSION}}.jsonl",
        "cwd": "{{PROJECT}}",
        "permission_mode": "default",
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__payments__create_charge",
        "tool_input": {
          "vendor": "gpucloud",
          "plan": "a100-24h-reservation",
          "amount_usd": 480,
          "currency": "USD",
          "description": "A100 for the fine-tune"
        },
        "tool_use_id": "toolu_{{N}}_gpu",
        "mcp_server": {
          "name": "payments"
        }
      },
      "expect": {
        "result": "pending|allow",
        "contains": "ACT-01|approved"
      }
    }
  ]
}
