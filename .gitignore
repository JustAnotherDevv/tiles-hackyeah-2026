# ---------------------------------------------------------------------------
# OpenHarmony / HarmonyOS (DevEco Studio, hvigor, ohpm)
# ---------------------------------------------------------------------------
# Dependencies (restored by `ohpm install`). Keep oh-package-lock.json5 committed.
oh_modules/
node_modules/

# hvigor caches and build output
.hvigor/
build/
**/build/
entry/build/
.cxx/
**/.test/
**/.preview/
.appanalyzer/

# Machine-local SDK paths (sdk.dir, nodejs.dir, ...)
local.properties

# Native / clang tooling
.clangd
.clang-format
.clang-tidy

# Build artifacts. Ship the .hap via GitHub Releases, not git history.
*.hap
*.hsp
*.app
# ...except the one judge-installable debug build (OpenHarmony debug keystore; no secrets inside).
!release/
!release/tiles-debug-signed.hap

# ---------------------------------------------------------------------------
# Signing material and secrets. NEVER commit these.
# DevEco auto-signing writes the material to ~/.ohos/config/, outside this repo.
# It also writes absolute paths and encrypted passwords into the
# app.signingConfigs block of build-profile.json5. Do not commit that block.
# See README.md -> "Signing".
# ---------------------------------------------------------------------------
*.p12
*.cer
*.p7b
*.csr
*.pem
*.key
*.jks
*.keystore
*.pfx
signing/
.ohos/
.env
.env.*
!.env.example
*.secret
secrets.*

# ---------------------------------------------------------------------------
# Local toolchain (SDK / emulator / command-line tools installed per machine)
# ---------------------------------------------------------------------------
.toolchain/

# ---------------------------------------------------------------------------
# Agent skills installed per machine (~26 MB of third-party content).
# Source: https://github.com/onirodeveloper/hackyeah2026-challenge/tree/main/skills
# plus the deveco-cli skill from `devecocli init --skill`. See README.md -> Setup.
# ---------------------------------------------------------------------------
.claude/skills/

# ---------------------------------------------------------------------------
# Agent / editor local state (shared skills above; personal settings never)
# ---------------------------------------------------------------------------
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md

# ---------------------------------------------------------------------------
# Python (root-level scripts; aegis/ has its own .gitignore as well)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Web prototypes / design explorations (design/**): dependencies + build output
# ---------------------------------------------------------------------------
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Scratch / temporary output (screenshots, recordings, emulator logs)
# ---------------------------------------------------------------------------
tmp/
scratch/
*.tmp
*.swp
*~

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.log


# Design prototype: keep source + refs, not the 9 MB bundle or vendored fonts/CSS/JS
design/tiles-motion/Tiles_Motion_bundle.html
design/tiles-motion/source/*.woff2
design/tiles-motion/source/https___*
design/tiles-motion/source/_template.html
